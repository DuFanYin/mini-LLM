{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-15",
        "CMAKE_CUDA_COMPILER": "/usr/local/cuda/bin/nvcc",
        "CMAKE_CUDA_HOST_COMPILER": "g++-15",
        "MINI_LLM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    { "name": "release", "inherits": "base", "displayName": "Release (-O3)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "debug", "inherits": "base", "displayName": "Debug (-O0 -g)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "jobs": 0 },
    { "name": "debug", "configurePreset": "debug", "jobs": 0 }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "no-weights", "configurePreset": "release", "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "weights" } } }
  ]
}
